# --- IA: Google Gemini ---
# Crea una API key gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza_xxxxxxxxxxxxxxxxxxxxxxxx
# Modelo. Comprueba el catálogo vigente en ai.google.dev/gemini-api/docs/models
#   - gemini-3.6-flash        modelo "workhorse" actual (def.)
#   - gemini-3.5-flash-lite   más barato/rápido para alto volumen
GEMINI_MODEL=gemini-3.6-flash

# --- Bot del grupo (@madaleno) ---
BOT_TRIGGER=@madaleno
# No hay lista de admins: el bot obedece a los ADMINISTRADORES DEL GRUPO
# en WhatsApp, y se actualiza sola cuando cambian.
# Límites anti-abuso / control de coste (por admin y hora)
QA_RATE_PER_HOUR=20
GIF_RATE_PER_HOUR=5

# --- Datos (CSV en data/docs/) ---
# Un CSV por grupo (con línea "grupo,,,,<id>") + ficheros comunes sin ella.
# Añadir un grupo nuevo = crear un CSV nuevo. No hace falta tocar nada aquí.

# --- Cumpleaños ---
BIRTHDAY_HOUR=11:30
# siempre -> felicita a esa hora pase lo que pase (def., sin coste IA)
# ia      -> comprueba con IA si ya le felicitaron
# nombre  -> comprueba por nombre + palabra de felicitación (sin IA)
BIRTHDAY_CHECK_GREET=siempre
# generico -> "🎉 ¡Feliz cumpleaños, X! 🎉" (def.)  |  ia -> texto variado
BIRTHDAY_STYLE=generico

# --- Efemérides ---
# Si el CSV no tiene nada para hoy, ¿preguntar a la IA? (puede equivocarse)
EPHEMERIS_FALLBACK_AI=false

# --- Web del calendario ---
# Puerto interno del servidor web (en Coolify se le asigna un dominio).
WEB_PORT=3001
# URL pública con la que el bot construye los enlaces. Sin esto, el comando
# "web" avisa de que no está configurada. Ej: https://cal.midominio.com
WEB_BASE_URL=
# Horas que dura cada enlace de edición (entregado por privado).
WEB_TOKEN_HORAS=24
# ¿Publicar el enlace en el propio grupo al escribir "@madaleno web"?
#   false -> el bot lo manda por privado solo a los admins (recomendado)
#   true  -> lo publica en el grupo: MUY cómodo, pero cualquier miembro
#            que pulse podrá editar (el enlace es la llave, no comprueba
#            quién eres). Los cambios se anuncian en el grupo.
WEB_LINK_EN_GRUPO=false
WEB_LINK_GRUPO_HORAS=2

# --- Orla ---
ORLA_WIDTH=1100
ORLA_MAX_MIEMBROS=60

# --- GIF ---
GIF_WIDTH=480
GIF_HEIGHT=480
GIF_FRAME_MS=1400

# --- Grupos a vigilar ---
# VACÍO = el bot atiende TODOS los grupos donde esté la SIM, respondiendo
# en cada uno con los datos de su CSV. Con ids, actúa como lista blanca.
GROUP_IDS=

# --- Otros ---
TIMEZONE=Europe/Madrid
